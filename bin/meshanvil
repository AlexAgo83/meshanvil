#!/usr/bin/env python3
"""Entry point. Standard library only: Blender is the one thing you have to install."""
import sys
from pathlib import Path

if sys.version_info < (3, 10):
    sys.exit(f"meshanvil needs Python 3.10 or later; this is {sys.version.split()[0]}")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from meshanvil.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
